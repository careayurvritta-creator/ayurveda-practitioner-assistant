# Supabase (browser-visible, safe for client)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# NVIDIA NIM API (primary LLM + embeddings provider)
NVIDIA_API_KEY=""

# Gemini API (optional fallback for LLM and embeddings)
GEMINI_API_KEY=""

# SerpAPI (optional, enables Google Scholar in treatment protocols)
SERPAPI_KEY=""

# NCBI API key (optional, increases PubMed rate limit)
NCBI_API_KEY=""

# Google OAuth credentials (used by Edge Functions for token exchange)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Supabase Edge Function secrets (set via: supabase secrets set ...)
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are auto-provisioned
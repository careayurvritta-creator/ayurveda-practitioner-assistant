# Supabase (browser-visible, safe for client)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Gemini API key (used by Edge Functions, not client)
GEMINI_API_KEY=""

# MiniMax M3 API key (required for embeddings and generation)
MINIMAX_M3_API_KEY=""

# Google OAuth credentials (used by Edge Functions for token exchange)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
